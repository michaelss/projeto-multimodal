# Copie este arquivo para .env e preencha com as suas chaves.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Pelo menos uma chave é necessária; com duas, o projeto troca de provedor sozinho.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Provedor principal: groq, gemini ou openai
PROVEDOR=groq
